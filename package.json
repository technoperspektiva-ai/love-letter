{
  "name": "love-letter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "node scripts/cloudflare-bootstrap.mjs && vite build && wrangler deploy",
    "cf:setup": "node scripts/cloudflare-bootstrap.mjs",
    "db:migrate:local": "wrangler d1 migrations apply love-letter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply love-letter-db --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.35.0"
  }
}
